# TouchLearn 大模型接入示例。复制为 .env 后填写，.env 已被 git 忽略。
# 所有值只从环境变量或本机 .env 读取；接口状态不会回传密钥本身。

# ---------- 文本模型：意图分类、函数表达式抽取、场景 JSON 生成 ----------
# 预置：openai / deepseek / dashscope / moonshot / zhipu / ollama / custom
TOUCHLEARN_LLM_PROVIDER=custom
TOUCHLEARN_LLM_URL=https://your-endpoint.example.com/v1
TOUCHLEARN_LLM_KEY=
TOUCHLEARN_LLM_MODEL=your-text-model

# ---------- 视觉模型：教材照片、工程图、函数图像 ----------
# 不填时，如果文本模型的预置自带视觉模型（如 dashscope / zhipu），会自动复用同一连接。
# 如果是自定义接口，请显式填写下面四项。
TOUCHLEARN_VLM_PROVIDER=custom
TOUCHLEARN_VLM_URL=https://your-endpoint.example.com/v1
TOUCHLEARN_VLM_KEY=
TOUCHLEARN_VLM_MODEL=your-vision-model

# 单次请求超时（秒），默认 75
TOUCHLEARN_LLM_TIMEOUT=75

# 可选：指定另一个 .env 文件路径
# TOUCHLEARN_ENV_FILE=D:/path/to/your.env

# ---------- 对外访问 ----------
# 公网暴露时务必设置访问码；分析与生成接口需要登录。
# 本地临时公网入口可用 python scripts/run_public.py 自动生成并写入 .touchlearn_access。
# TOUCHLEARN_ACCESS_CODE=TL-XXXXXXXX
# 固定域名/隧道地址；留空时按请求 Host 自动推导，二维码会跟着当前访问地址走。
# TOUCHLEARN_PUBLIC_URL=https://touchlearn.example.com
