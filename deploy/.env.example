# 复制为 deploy/.env 后再填写；deploy/.env 已被 .gitignore 忽略。
# domain = 已备案域名 + Caddy 自动 HTTPS；ip = 公网 IP + 端口，不启用 HTTPS
DEPLOY_MODE=domain

# 仅 domain 模式使用：已解析到这台服务器的域名
SITE_ADDRESS=touch.example.com
# 对外访问地址，用于二维码和音频页。IP 模式示例：http://1.2.3.4:8765
TOUCHLEARN_PUBLIC_URL=https://touch.example.com

# 仅 ip 模式使用：宿主机映射端口，默认 8765
# TOUCHLEARN_HOST_PORT=8765

# 账号与验证码：手机号或邮箱验证码登录，首次验证自动注册。
# 账号库放在持久卷里；容器内路径固定为 /app/outputs/accounts.sqlite3。
TOUCHLEARN_AUTH_DB=/app/outputs/accounts.sqlite3
# 生产环境必须显式关闭开发模式。
TOUCHLEARN_AUTH_DEV_MODE=false

# 邮件验证码（二选一或都配）。QQ 企业邮/163 等都要用“客户端授权码”，不是登录密码。
TOUCHLEARN_SMTP_HOST=smtp.exmail.qq.com
TOUCHLEARN_SMTP_PORT=465
TOUCHLEARN_SMTP_USER=no-reply@example.com
TOUCHLEARN_SMTP_PASSWORD=
TOUCHLEARN_SMTP_FROM=触见 <no-reply@example.com>
TOUCHLEARN_SMTP_TLS=ssl

# 手机验证码（阿里云短信）。需先在阿里云申请签名和模板。
# TOUCHLEARN_SMS_PROVIDER=aliyun
# TOUCHLEARN_ALIYUN_SMS_KEY_ID=
# TOUCHLEARN_ALIYUN_SMS_KEY_SECRET=
# TOUCHLEARN_ALIYUN_SMS_SIGN_NAME=触见
# TOUCHLEARN_ALIYUN_SMS_TEMPLATE_CODE=SMS_...
# TOUCHLEARN_ALIYUN_SMS_REGION=cn-hangzhou

# 大陆服务器备案通过后填写，展示在登录页和设置页
TOUCHLEARN_ICP_BEIAN=

# 大陆服务器构建慢时启用 PyPI 镜像（也可以留空用官方源）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 大模型可以留空，离线仍能跑函数、模板和电路编辑器。
# 大陆服务器请使用可达的国内接口：tokenhub / deepseek / dashscope / moonshot / zhipu。
TOUCHLEARN_LLM_PROVIDER=tokenhub
TOUCHLEARN_LLM_KEY=
TOUCHLEARN_LLM_MODEL=deepseek-v4.1-flash
TOUCHLEARN_VLM_PROVIDER=tokenhub
TOUCHLEARN_VLM_MODEL=deepseek/deepseek-flash
TOUCHLEARN_LLM_TIMEOUT=120

# 三维生成：推荐 TokenHub（可与 TOUCHLEARN_LLM_KEY 共用同一个 Key）。
# 文字直接生成完整网格，照片走图生 3D；也可选 Tripo 官方接口或 Meshy。
# 留空时生成式路径关闭，回退到本地确定性 3D 编译器；触觉教材不受影响。
# 密钥只从环境变量读取，不写入作业目录。
TOUCHLEARN_3D_PROVIDER=tokenhub
# 留空时自动复用 TOUCHLEARN_LLM_KEY（仅 tokenhub 生效）
TOUCHLEARN_3D_KEY=
# 文字生成 3D 模型：tripo-3d-3.1（默认）/ hy-3d-3.1 / hy-3d-3.0 / tripo-3d-p1 / tripo-3d-p2
TOUCHLEARN_3D_TEXT_MODEL=tripo-3d-3.1
# 图生 3D 模型：tripo-3d-p1（默认，支持单图 input 与多视图 inputs）/ hy-3d-3.1（image_base64）
TOUCHLEARN_3D_MODEL=tripo-3d-p1
# 注意：hy-3d-motion 生成动画，不是可打印静态网格，本产品不使用。
# 质量档位：draft / standard / high（默认 high）
TOUCHLEARN_3D_QUALITY=high
# 0 = 关闭生成式路径，强制回退本地结构化编译器
TOUCHLEARN_3D_GENERATIVE=1
# 图生 3D 面数，3000–2000000；默认 300000（Tripo 3.1 可到 200 万）
TOUCHLEARN_3D_FACES=300000
TOUCHLEARN_3D_TIMEOUT=600
TOUCHLEARN_3D_POLL=4
# 是否把用户的文字指令整理成 provider prompt（1 开启，0 关闭）
# TokenHub 图生 3D 不能同时提交 prompt 和照片，此开关只对 Tripo / Meshy 的图生路径生效。
TOUCHLEARN_3D_PROMPT=1
# 仅当服务器必须经过代理访问三维服务时填写
# TOUCHLEARN_3D_PROXY=http://127.0.0.1:7890
