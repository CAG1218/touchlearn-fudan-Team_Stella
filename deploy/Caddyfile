{$SITE_ADDRESS} {
	encode zstd gzip

	# 上传上限与服务端保持一致（96 MB 请求体）。
	request_body {
		max_size 96MB
	}

	reverse_proxy touchlearn:8765 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
