{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CAG1218/touchlearn-fudan-Team_Stella/schemas/diagram.schema.json",
  "title": "TouchLearn Diagram",
  "description": "Semantic contract for a STEM diagram that TouchLearn compiles into a tactile A5 plate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "domain",
    "canvas",
    "source",
    "elements",
    "relations",
    "layout",
    "constraints",
    "audio"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 3,
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "title_zh": {
      "type": "string",
      "maxLength": 120
    },
    "domain": {
      "type": "string",
      "enum": ["robotics", "math", "other"]
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "width_mm", "height_mm"],
      "properties": {
        "size": {"type": "string", "enum": ["A5", "A4"]},
        "width_mm": {"type": "number", "exclusiveMinimum": 0},
        "height_mm": {"type": "number", "exclusiveMinimum": 0},
        "margin_mm": {"type": "number", "minimum": 0}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["photo", "sketch", "textbook", "expression", "manual", "other"]
        },
        "ref": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "order"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 40
          },
          "kind": {
            "type": "string",
            "enum": [
              "link",
              "joint",
              "joint_group",
              "end_effector",
              "curve",
              "point",
              "axis",
              "label",
              "legend",
              "other"
            ]
          },
          "label": {"type": "string", "minLength": 1, "maxLength": 24},
          "label_zh": {"type": "string", "maxLength": 40},
          "order": {"type": "integer", "minimum": 1, "maximum": 12},
          "semantics": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "kind"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "kind": {
            "type": "string",
            "enum": ["joint", "connect", "contains", "on_curve", "through", "other"]
          },
          "joint": {"type": "string", "maxLength": 12},
          "order": {"type": "integer", "minimum": 0},
          "semantics": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "options"],
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["kinematic_chain", "cartesian_plot"]
        },
        "options": {"type": "object", "additionalProperties": true}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "max_features",
        "min_line_width_mm",
        "min_spacing_mm",
        "base_thickness_mm",
        "relief_height_mm",
        "braille_dot_mm",
        "braille_height_mm"
      ],
      "properties": {
        "max_features": {"type": "integer", "minimum": 1, "maximum": 12},
        "min_line_width_mm": {"type": "number", "minimum": 0.8, "maximum": 3.0},
        "min_spacing_mm": {"type": "number", "minimum": 2.0, "maximum": 10.0},
        "base_thickness_mm": {"type": "number", "minimum": 2.0, "maximum": 5.0},
        "relief_height_mm": {"type": "number", "minimum": 0.4, "maximum": 0.8},
        "braille_dot_mm": {"type": "number", "minimum": 1.2, "maximum": 2.0},
        "braille_height_mm": {"type": "number", "minimum": 0.4, "maximum": 0.8}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intro", "steps"],
      "properties": {
        "intro": {"type": "string", "minLength": 1},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "outro": {"type": "string"}
      }
    }
  }
}
