# TouchLearn 大模型接入示例。复制为 .env 后填写，.env 已被 git 忽略。
# 所有值只从环境变量或本机 .env 读取；接口状态不会回传密钥本身。

# 腾讯云 TokenHub 示例（一个 Key 可用 DeepSeek / GLM / Kimi 等模型）：
# TOUCHLEARN_LLM_PROVIDER=tokenhub
# TOUCHLEARN_LLM_KEY=sk-...
# TOUCHLEARN_LLM_MODEL=deepseek-v4.1-flash
# TOUCHLEARN_VLM_PROVIDER=tokenhub
# TOUCHLEARN_VLM_MODEL=deepseek/deepseek-flash
# TOUCHLEARN_SCENE_MODEL=deepseek-v4.1-flash
# TOUCHLEARN_LLM_EFFORT=low
# TOUCHLEARN_SCENE_EFFORT=off

# DeepSeek 直连示例（V4 Pro 文本 + V4.1 Flash 读图/场景 JSON）：
# TOUCHLEARN_LLM_PROVIDER=deepseek
# TOUCHLEARN_LLM_KEY=sk-...
# TOUCHLEARN_LLM_MODEL=deepseek-v4-pro
# TOUCHLEARN_VLM_PROVIDER=deepseek
# TOUCHLEARN_VLM_MODEL=deepseek-flash
# TOUCHLEARN_SCENE_MODEL=deepseek-flash
# TOUCHLEARN_LLM_EFFORT=low
# TOUCHLEARN_SCENE_EFFORT=off

# ---------- 文本模型：意图分类、函数表达式抽取、场景 JSON 生成 ----------
# 预置：openai / deepseek / tokenhub / dashscope / moonshot / zhipu / ollama / custom
TOUCHLEARN_LLM_PROVIDER=custom
TOUCHLEARN_LLM_URL=https://your-endpoint.example.com/v1
TOUCHLEARN_LLM_KEY=
TOUCHLEARN_LLM_MODEL=your-text-model

# ---------- 视觉模型：教材照片、工程图、函数图像 ----------
# 不填时，如果文本模型的预置自带视觉模型（如 dashscope / zhipu / tokenhub），会自动复用同一连接。
# 如果是自定义接口，请显式填写下面四项。
TOUCHLEARN_VLM_PROVIDER=custom
TOUCHLEARN_VLM_URL=https://your-endpoint.example.com/v1
TOUCHLEARN_VLM_KEY=
TOUCHLEARN_VLM_MODEL=your-vision-model

# 单次请求超时（秒），默认 75
TOUCHLEARN_LLM_TIMEOUT=75

# 单次回答的输出额度（不是账号的 token 配额）。留空时按服务商预置：
# TokenHub 65536、DeepSeek 32768、OpenAI 16384，其他 4096–16384。
# 思考型模型会把隐藏的推理 token 计入这个额度，所以这里不要再填 4096 之类的小值。
# 设为 0 表示不发送 max_tokens 字段，完全交给服务商决定上限。
# TOUCHLEARN_MAX_OUTPUT_TOKENS=65536

# ---------- 三维生成：TokenHub / Tripo 3D / Meshy ----------
# 文字直接生成完整网格；照片走图生 3D。返回的带纹理 GLB 会在本地确定性地
# 加标题、底座、方向、盲文和二维码位，并生成可打印 STL。留空时关闭生成式路径，
# 回退到本地结构化编译器（太阳系目录始终走本地编译器）。
# 推荐 TokenHub：与上面的 TOUCHLEARN_LLM_KEY 可以是同一个 Key。
#   tokenhub → 文字默认 tripo-3d-3.1，图生默认 tripo-3d-p1（支持单图与多视图）
#   tripo    → Tripo 官方接口
#   meshy    → Meshy 官方接口
# 注意：hy-3d-motion 生成的是动画，不是可打印静态网格，本产品不使用。
TOUCHLEARN_3D_PROVIDER=tokenhub
# 留空时自动复用 TOUCHLEARN_LLM_KEY（仅 tokenhub 生效）
TOUCHLEARN_3D_KEY=
# 文字生成 3D 的模型；可换 hy-3d-3.1 / hy-3d-3.0 / tripo-3d-p1 / tripo-3d-p2 / hy-3d-express
TOUCHLEARN_3D_TEXT_MODEL=tripo-3d-3.1
# 图生 3D 模型：tripo-3d-p1 支持 input 单图与 inputs 多视图；hy-3d-3.1 走 image_base64
TOUCHLEARN_3D_MODEL=tripo-3d-p1
# 质量档位：draft / standard / high（默认 high，面数与纹理质量更高）
TOUCHLEARN_3D_QUALITY=high
# 0 = 关闭生成式路径，强制回退本地结构化编译器
TOUCHLEARN_3D_GENERATIVE=1
# 图生 3D 面数，3000–2000000；默认 300000（Tripo 3.1 可到 200 万）
TOUCHLEARN_3D_FACES=300000
TOUCHLEARN_3D_TIMEOUT=600
TOUCHLEARN_3D_POLL=4
# 是否把用户文字指令整理成 provider prompt（1 开启，0 关闭）
# 注意：TokenHub 图生 3D 的 prompt 与照片不能同时提交，此开关只对 Tripo / Meshy 的图生路径生效；
# 文字里的“保留/调整”由本地确定性后处理执行。
TOUCHLEARN_3D_PROMPT=1
# 仅当本机必须经过代理访问三维服务时填写
# TOUCHLEARN_3D_PROXY=http://127.0.0.1:7890

# 初始思考强度（仅对支持该开关的服务生效，如 DeepSeek / TokenHub）：low / medium / high
# 这里只是服务启动后的初始值；用户可以在页面模型菜单里随时切换。
# DeepSeek 与 TokenHub 预置默认 low，避免推理 token 占满输出预算。
# TOUCHLEARN_LLM_EFFORT=low

# 场景 JSON 的初始模型与强度；留空时用文本模型。页面选择优先于这两个值。
# TOUCHLEARN_SCENE_MODEL=
# TOUCHLEARN_SCENE_EFFORT=off

# 仅当本机必须经过代理访问外网时填写（默认忽略系统代理，避免代理未启动时请求超时）
# TOUCHLEARN_LLM_PROXY=http://127.0.0.1:7890

# 可选：指定另一个 .env 文件路径
# TOUCHLEARN_ENV_FILE=D:/path/to/your.env

# ---------- 3D 打印机直连（可选扩展，默认关闭） ----------
# 生成好的 model.stl 可以发送到 OctoPrint 或 Klipper/Moonraker。
# 不配置时界面会提示去配置；配置了打印机但不设 TOUCHLEARN_PRINT_ALLOW 时只做演练，
# 仍会检查打印床尺寸、文件体积和三角面数量，但不会连接打印机。
# 详见 docs/printer-integration.md
# TOUCHLEARN_PRINTER_KIND=octoprint
# TOUCHLEARN_PRINTER_URL=http://192.168.1.50
# TOUCHLEARN_PRINTER_KEY=OctoPrint 设置里生成的应用密钥
# TOUCHLEARN_PRINTER_BED=220x220x250
# TOUCHLEARN_PRINTER_LABEL=实验室打印机
# 多台打印机用 JSON 数组，字段：id / label / kind / url / api_key / bed_mm
# TOUCHLEARN_PRINTERS=[{"id":"prusa","kind":"octoprint","url":"http://192.168.1.50","api_key":"...","bed_mm":[250,210,220]}]
# 真实打印必须显式打开；不设置就是演练模式
# TOUCHLEARN_PRINT_ALLOW=1
# 强制演练（即使上面打开）
# TOUCHLEARN_PRINT_DRY_RUN=1

# ---------- 对外访问 ----------
# 账号系统使用手机号或邮箱验证码登录，首次验证自动注册；不再使用访问码。
# 账号库默认 <outputs>/accounts.sqlite3，生产环境请放到持久卷。
# TOUCHLEARN_AUTH_DB=/app/outputs/accounts.sqlite3
# 生产环境务必显式关闭开发模式，否则验证码会直接显示在页面上。
# TOUCHLEARN_AUTH_DEV_MODE=false
# 邮件验证码（SMTP）。TLS 可选 ssl / starttls / none。
# TOUCHLEARN_SMTP_HOST=smtp.exmail.qq.com
# TOUCHLEARN_SMTP_PORT=465
# TOUCHLEARN_SMTP_USER=no-reply@example.com
# TOUCHLEARN_SMTP_PASSWORD=...
# TOUCHLEARN_SMTP_FROM=触见 <no-reply@example.com>
# TOUCHLEARN_SMTP_TLS=ssl
# 手机验证码（阿里云短信，需提前申请签名和模板）。
# TOUCHLEARN_SMS_PROVIDER=aliyun
# TOUCHLEARN_ALIYUN_SMS_KEY_ID=...
# TOUCHLEARN_ALIYUN_SMS_KEY_SECRET=...
# TOUCHLEARN_ALIYUN_SMS_SIGN_NAME=触见
# TOUCHLEARN_ALIYUN_SMS_TEMPLATE_CODE=SMS_...
# TOUCHLEARN_ALIYUN_SMS_REGION=cn-hangzhou
# 验证码与会话参数（一般不用改）。
# TOUCHLEARN_AUTH_CODE_TTL=600
# TOUCHLEARN_AUTH_RESEND_AFTER=60
# TOUCHLEARN_AUTH_SESSION_DAYS=30
# TOUCHLEARN_AUTH_CODES_PER_HOUR=8
# TOUCHLEARN_AUTH_CODES_PER_IP_HOUR=40
# 固定域名/隧道地址；留空时按请求 Host 自动推导，二维码会跟着当前访问地址走。
# TOUCHLEARN_PUBLIC_URL=https://touchlearn.example.com
